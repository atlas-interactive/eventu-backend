server.port=8080

spring.datasource.url=jdbc:postgresql://<TU_HOST_SUPABASE>:5432/postgres?sslmode=require
spring.datasource.username=postgres
spring.datasource.password=<TU_CONTRASEÑA_AQUÍ>

spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=true

# Orígenes del frontend permitidos por CORS, separados por coma.
# En producción agrega la URL del frontend desplegado (por ejemplo la de Vercel).
eventu.cors.origenes=http://localhost:5173

eventu.jwt.secret=${JWT_SECRET}

# Correo (SendGrid por API HTTP). Si la clave está vacía, los correos no se envían y solo se deja un aviso en el log
eventu.correo.sendgrid-api-key=${SENDGRID_API_KEY:}
eventu.correo.remitente=admineventu@gmail.com
eventu.jwt.expiracion-ms=86400000
